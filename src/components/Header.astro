---
import { site, navigation } from '../data/site';

const path = Astro.url.pathname;

function isCurrent(href: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}
---

<header>
  <div class="container bar">
    <a class="wordmark" href="/">
      <span class="status-dot" aria-hidden="true"></span>
      <span class="name">{site.title}</span>
      <span class="sig" aria-hidden="true">//</span>
    </a>

    <nav aria-label="Main">
      <ul>
        {
          navigation.map((item, i) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <span class="idx" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background-color: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(10px);
    border-block-end: var(--border);
  }

  .bar {
    min-height: var(--header-height);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-md);
    padding-block: var(--space-2xs);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
  }

  .wordmark:hover .name {
    color: var(--color-accent);
    text-shadow: var(--glow-text);
  }

  .sig {
    color: var(--color-accent);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    list-style: none;
    padding: 0;
  }

  nav a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3xs);
    padding: var(--space-3xs) var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    border: var(--border-width) solid transparent;
  }

  .idx {
    font-size: var(--text-2xs);
    color: var(--color-text-subtle);
  }

  nav a:hover {
    color: var(--color-text);
    border-color: var(--color-border);
  }

  /* aria-current is the source of truth; the lit border is its visual echo. */
  nav a[aria-current='page'] {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: var(--color-accent-wash);
  }

  nav a[aria-current='page'] .idx {
    color: var(--color-accent);
  }
</style>
