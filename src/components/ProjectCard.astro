---
import { Image } from 'astro:assets';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
  headingLevel?: 2 | 3;
  /** Zero-based position, rendered as a technical record number (001, 002…). */
  index?: number;
}

const { project, headingLevel = 2, index } = Astro.props;
const { title, summary, tags, year, stack, cover, coverAlt, draft } = project.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const href = `/projects/${project.id}`;
const recordNo = index === undefined ? null : String(index + 1).padStart(3, '0');
---

<article class="card bracketed">
  {
    cover && (
      <Image
        class="cover"
        src={cover}
        alt={coverAlt ?? ''}
        widths={[400, 800]}
        sizes="(min-width: 48rem) 24rem, 100vw"
        loading="lazy"
        decoding="async"
      />
    )
  }

  <div class="body">
    <p class="meta">
      {recordNo && <span class="rec">REC {recordNo}</span>}
      <span class="year">{year}</span>
      {draft && <span class="badge">Draft</span>}
    </p>

    <Heading class="title">
      <a href={href}>{title}</a>
    </Heading>

    <p class="summary">{summary}</p>

    <div class="foot">
      {
        stack.length > 0 && (
          <p class="stack">
            <span class="visually-hidden">Built with: </span>
            {stack.join(' / ')}
          </p>
        )
      }

      {
        tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {tags.slice(0, 4).map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: var(--color-surface);
    border: var(--border);
    transition:
      border-color var(--duration-base) var(--ease),
      background-color var(--duration-base) var(--ease),
      box-shadow var(--duration-base) var(--ease);
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--color-accent);
    background-color: var(--color-surface-raised);
    box-shadow: var(--glow-accent-soft);
  }

  .card:focus-within {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .card:focus-within .title a:focus-visible {
    outline: none;
  }

  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-block-end: var(--border);
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-sm);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .rec {
    color: var(--color-accent);
  }

  .year {
    font-variant-numeric: tabular-nums;
  }

  .badge {
    margin-inline-start: auto;
    padding: 0 var(--space-3xs);
    border: var(--border-width) solid var(--color-accent-2);
    background-color: var(--color-accent-2-wash);
    color: var(--color-accent-2);
  }

  .title {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-normal);
  }

  .title a {
    color: var(--color-text);
    text-decoration: none;
  }

  /* Stretched link — whole card clickable, accessible name stays the title. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover .title a {
    color: var(--color-accent);
  }

  .summary {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .foot {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-block-start: auto;
    padding-block-start: var(--space-xs);
  }

  .stack {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    list-style: none;
    padding: 0;
  }

  .tags li {
    padding: var(--space-3xs) var(--space-2xs);
    border: var(--border);
    color: var(--color-text-muted);
    font-family: var(--font-display);
    font-size: var(--text-2xs);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-wide);
  }
</style>
