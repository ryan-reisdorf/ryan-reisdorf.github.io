---
import { Image } from 'astro:assets';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
  /** Renders the title as <h2> (default) or <h3> when nested under a section heading. */
  headingLevel?: 2 | 3;
}

const { project, headingLevel = 2 } = Astro.props;
const { title, summary, tags, year, stack, cover, coverAlt, draft } = project.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const href = `/projects/${project.id}`;
---

<article class="card" data-tags={tags.join(' ')}>
  {
    cover && (
      /* widths + sizes emit a srcset; the intrinsic dimensions Astro writes
         onto the tag are what hold the space and keep CLS at zero. */
      <Image
        class="cover"
        src={cover}
        alt={coverAlt ?? ''}
        widths={[400, 800]}
        sizes="(min-width: 46rem) 24rem, 100vw"
        loading="lazy"
        decoding="async"
      />
    )
  }

  <div class="body">
    <p class="meta">
      <span>{year}</span>
      {draft && <span class="badge">Draft</span>}
    </p>

    <Heading class="title">
      {/* Stretched-link pattern: one real link, whole card clickable, and the
          accessible name stays exactly the project title. */}
      <a href={href}>{title}</a>
    </Heading>

    <p class="summary">{summary}</p>

    {
      stack.length > 0 && (
        <p class="stack">
          <span class="visually-hidden">Built with: </span>
          {stack.join(' · ')}
        </p>
      )
    }

    {
      tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      border-color var(--duration-base) var(--ease),
      transform var(--duration-base) var(--ease),
      box-shadow var(--duration-base) var(--ease);
  }

  .card:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  /* Focus lands on the inner <a>, but the ring should read as "the card". */
  .card:focus-within {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .card:focus-within .title a:focus-visible {
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
  }

  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-block-end: var(--border);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-sm);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--text-2xs);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .badge {
    padding: 0 var(--space-3xs);
    border: var(--border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
  }

  .title {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .title a {
    color: var(--color-text);
    text-decoration: none;
  }

  /* Expands the link's hit area to the whole card without nesting anything
     inside the anchor. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover .title a {
    color: var(--color-accent);
  }

  .summary {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .stack {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin-block-start: var(--space-3xs);
    list-style: none;
    padding: 0;
  }

  .tags li {
    padding: var(--space-3xs) var(--space-2xs);
    background-color: var(--color-accent-wash);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    font-size: var(--text-2xs);
    line-height: var(--leading-none);
  }
</style>
