---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resume } from '../data/resume';

/*
 * Rendered entirely from src/data/resume.ts. Do not hard-code résumé content
 * in this file — the whole point is that the page and the PDF share one source.
 */
const { name, headline, location, summary, experience, education, skills, certifications, updated } =
  resume;
---

<BaseLayout title="Résumé" description={`${name} — ${headline}`}>
  <div class="container container--narrow">
    <header class="head">
      <h1>{name}</h1>
      <p class="headline">{headline}</p>
      <p class="location">{location}</p>

      <p class="actions">
        <a class="download" href="/resume.pdf" download>Download PDF</a>
      </p>
    </header>

    <section aria-labelledby="summary-heading">
      <h2 id="summary-heading">Summary</h2>
      <p class="summary">{summary}</p>
    </section>

    <section aria-labelledby="experience-heading">
      <h2 id="experience-heading">Experience</h2>
      {
        experience.map((role) => (
          <article class="entry">
            <div class="entry-head">
              <h3>
                {role.title} <span class="at">·</span> <span class="org">{role.organization}</span>
              </h3>
              <p class="dates">
                <span>
                  {role.start} – {role.end}
                </span>
                <span class="where">{role.location}</span>
              </p>
            </div>
            {role.summary && <p class="entry-summary">{role.summary}</p>}
            {role.highlights.length > 0 && (
              <ul>
                {role.highlights.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </section>

    <section aria-labelledby="education-heading">
      <h2 id="education-heading">Education</h2>
      {
        education.map((entry) => (
          <article class="entry">
            <div class="entry-head">
              <h3>
                {entry.credential} <span class="at">·</span>{' '}
                <span class="org">{entry.institution}</span>
              </h3>
              <p class="dates">
                <span>{entry.start ? `${entry.start} – ${entry.end}` : entry.end}</span>
                {entry.location && <span class="where">{entry.location}</span>}
              </p>
            </div>
            {entry.notes && entry.notes.length > 0 && (
              <ul>
                {entry.notes.map((note) => (
                  <li>{note}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </section>

    <section aria-labelledby="skills-heading">
      <h2 id="skills-heading">Skills</h2>
      <dl class="skills">
        {
          skills.map((group) => (
            <div>
              <dt>{group.label}</dt>
              <dd>{group.items.join(' · ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      certifications.length > 0 && (
        <section aria-labelledby="certs-heading">
          <h2 id="certs-heading">Certifications</h2>
          <ul class="certs">
            {certifications.map((cert) => (
              <li>
                <strong>{cert.name}</strong> — {cert.issuer}, {cert.earned}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="updated">Last updated {updated}.</p>
  </div>
</BaseLayout>

<style>
  .head {
    padding-block-end: var(--space-md);
    margin-block-end: var(--space-lg);
    border-block-end: var(--border);
  }

  h1 {
    font-size: var(--text-2xl);
  }

  .headline {
    margin-block-start: var(--space-3xs);
    color: var(--color-text-muted);
    font-size: var(--text-md);
  }

  .location {
    margin-block-start: var(--space-3xs);
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .actions {
    margin-block-start: var(--space-md);
  }

  .download {
    display: inline-block;
    padding: var(--space-2xs) var(--space-sm);
    background-color: var(--color-accent);
    border-radius: var(--radius-md);
    color: var(--color-accent-contrast);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .download:hover {
    background-color: var(--color-accent-hover);
    color: var(--color-accent-contrast);
  }

  section + section {
    margin-block-start: var(--space-xl);
  }

  h2 {
    padding-block-end: var(--space-3xs);
    margin-block-end: var(--space-sm);
    border-block-end: var(--border);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .summary {
    max-width: var(--measure);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .entry + .entry {
    margin-block-start: var(--space-md);
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3xs) var(--space-sm);
  }

  h3 {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
  }

  .at {
    color: var(--color-text-subtle);
  }

  .org {
    color: var(--color-accent);
  }

  .dates {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .where::before {
    content: '· ';
  }

  .entry-summary {
    margin-block-start: var(--space-2xs);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .entry ul {
    margin-block-start: var(--space-2xs);
    padding-inline-start: var(--space-md);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .entry li + li {
    margin-block-start: var(--space-3xs);
  }

  .skills {
    display: grid;
    gap: var(--space-xs);
  }

  .skills dt {
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .skills dd {
    margin: 0;
    margin-block-start: var(--space-3xs);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .certs {
    padding-inline-start: var(--space-md);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .certs strong {
    color: var(--color-text);
  }

  .updated {
    margin-block-start: var(--space-xl);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  /* Print: strip chrome so Ctrl-P from this page produces the PDF.
     See README → "Regenerating the PDF". */
  @media print {
    .actions {
      display: none;
    }
  }
</style>
