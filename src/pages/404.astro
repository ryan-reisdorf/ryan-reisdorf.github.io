---
import BaseLayout from '../layouts/BaseLayout.astro';

/*
 * GitHub Pages serves /404.html automatically for unmatched paths — no config
 * needed beyond this file existing.
 */
---

<BaseLayout title="Signal lost" description="That page doesn't exist." noindex>
  <div class="container container--narrow">
    <div class="panel bracketed">
      <p class="eyebrow">
        <span class="dot" aria-hidden="true"></span>
        Signal lost<span class="jp" lang="ja" aria-hidden="true">信号消失</span>
      </p>

      <p class="code" aria-hidden="true">404</p>

      <h1>No route to that page.</h1>

      <p class="body">
        The link is stale, or I moved something. Nothing here is monitored — which is ironic, given
        the day job.
      </p>

      <hr class="rule" />

      <nav aria-label="Recovery">
        <ul class="options">
          <li><a href="/">Home</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/resume">Résumé</a></li>
          <li><a href="/links">Links</a></li>
        </ul>
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .panel {
    margin-block: var(--space-2xl);
    padding: var(--space-lg);
    border: var(--border);
    background-color: var(--color-surface);
  }

  /* Magenta rather than the usual cyan — this is the one alarm state. */
  .dot {
    width: var(--space-2xs);
    height: var(--space-2xs);
    flex: none;
    background-color: var(--color-accent-2);
    border-radius: var(--radius-full);
    box-shadow: var(--glow-accent-2);
  }

  .code {
    margin-block-start: var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-tight);
    color: var(--color-accent-2);
  }

  h1 {
    margin-block-start: var(--space-sm);
    font-size: var(--text-xl);
  }

  .body {
    margin-block-start: var(--space-2xs);
    max-width: var(--measure);
    color: var(--color-text-muted);
  }

  .rule {
    margin-block: var(--space-lg);
  }

  .options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    padding: 0;
    list-style: none;
  }

  .options a {
    display: inline-block;
    padding: var(--space-3xs) var(--space-2xs);
    border: var(--border);
    font-family: var(--font-display);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    text-decoration: none;
    transition: var(--transition-colors);
  }

  .options a:hover {
    border-color: var(--color-accent);
    box-shadow: var(--glow-accent-soft);
  }
</style>
