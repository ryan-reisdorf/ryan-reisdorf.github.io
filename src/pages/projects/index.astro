---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectBrowser from '../../components/ProjectBrowser.astro';
import { getProjects, getTags } from '../../lib/projects';

const projects = await getProjects();
const tags = await getTags();
---

<BaseLayout
  title="Projects"
  description="Things I've built — test automation, monitoring tooling, and homelab infrastructure."
>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">
        Archive<span class="jp" lang="ja" aria-hidden="true">記録</span>
      </p>
      <h1>Projects</h1>
      <hr class="rule" />
      <p>
        Work I've built and maintained. Filter by tag — the filters are plain links to real pages,
        so they work with JavaScript disabled too.
      </p>
    </header>

    <ProjectBrowser projects={projects} tags={tags} activeTag={null} />
  </div>
</BaseLayout>

<style>
  .page-head {
    max-width: var(--measure);
    margin-block-end: var(--space-lg);
  }

  h1 {
    margin-block-start: var(--space-3xs);
    font-size: var(--text-2xl);
  }

  .rule {
    margin-block: var(--space-md);
  }

  .page-head p:not(.eyebrow) {
    color: var(--color-text-muted);
  }
</style>
