---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getFeaturedProjects } from '../lib/projects';
import { site } from '../data/site';

const featured = await getFeaturedProjects(3);
---

<BaseLayout title={site.title} isHome>
  <div class="container">
    <section class="hero" aria-labelledby="hero-heading">
      <p class="eyebrow">{site.tagline}</p>
      <h1 id="hero-heading">
        I'm Ryan — I break software on purpose, then build the tools that keep it broken-proof.
        {/* TODO: rewrite this in your own voice. One or two lines, no buzzwords. */}
      </h1>

      <div class="bio">
        <p>
          {/* TODO: replace with your own bio. Keep the shape: what you do now, what
              you're studying, what you do for fun. Two short paragraphs is plenty. */}
          I'm a QA engineer at <strong>Nagios</strong>, where I work on test automation and build
          custom dashlets for Nagios XI. Most of what I enjoy sits at the seam between testing and
          tooling — the harness, the fixture, the dashboard that finally makes a failure obvious.
        </p>
        <p>
          Outside work I run <strong>Erebus Station</strong>, a homelab that doubles as a testbed for
          everything I'm learning in my cybersecurity master's. It is occasionally on fire, which is
          the point.
        </p>
      </div>

      <div class="actions">
        <a class="button button--primary" href="/projects">View projects</a>
        <a class="button" href="/resume">Résumé</a>
      </div>
    </section>

    <section class="featured" aria-labelledby="featured-heading">
      <div class="section-head">
        <h2 id="featured-heading">Selected work</h2>
        <a class="see-all" href="/projects">All projects →</a>
      </div>

      {
        featured.length > 0 ? (
          <ul class="grid">
            {featured.map((project) => (
              <li>
                <ProjectCard project={project} headingLevel={3} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">No projects published yet.</p>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    max-width: var(--container-narrow);
    padding-block: var(--space-lg) var(--space-2xl);
  }

  h1 {
    margin-block-start: var(--space-2xs);
    font-size: var(--text-2xl);
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-block-start: var(--space-md);
    max-width: var(--measure);
    color: var(--color-text-muted);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
  }

  .bio strong {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-lg);
  }

  .button {
    display: inline-block;
    padding: var(--space-2xs) var(--space-sm);
    background-color: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition: var(--transition-colors);
  }

  .button:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .button--primary {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  .button--primary:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: var(--color-accent-contrast);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-sm);
    margin-block-end: var(--space-sm);
    padding-block-end: var(--space-2xs);
    border-block-end: var(--border);
  }

  h2 {
    font-size: var(--text-xl);
  }

  .see-all {
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-sm);
    list-style: none;
    padding: 0;
  }

  .empty {
    color: var(--color-text-muted);
  }
</style>
